@model UserManagement.Web.Models.UserListViewModel

<h2>User List</h2>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Forename</th>
                <th>Surname</th>
                <th>Email</th>
                <th>Account Active</th>
                <th style="width: 1px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @item.Id
                    </td>
                    <td>
                        @item.Forename
                    </td>
                    <td>
                        @item.Surname
                    </td>
                    <td>
                        @item.Email
                    </td>
                    <td>
                        @(item.IsActive ? "Yes" : "No")
                    </td>
                    <td>
                        <div class="btn-group" role="group" aria-label="Actions for @item.Forename @item.Surname">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div>
    <div class="btn-group" role="group">
          <a asp-action="List"
              class="btn @(Model.IsActive is null ? "btn-primary" : "btn-outline-primary")"
              aria-pressed="@(Model.IsActive is null)">Show All</a>
        <a asp-action="List" asp-route-isActive="true"
              class="btn @(Model.IsActive is true ? "btn-primary" : "btn-outline-primary")"
              aria-pressed="@(Model.IsActive is true)">Active only</a>
          <a asp-action="List" asp-route-isActive="false"
              class="btn @(Model.IsActive is false ? "btn-primary" : "btn-outline-primary")"
              aria-pressed="@(Model.IsActive is false)">Inactive only</a>
     </div>

    <a asp-action="Create" class="btn btn-primary float-end">
        Add User
    </a>
</div>

